# IONOS OpenShift Scaling Tool — environment configuration
# Copy this file to .env (or .env.<cluster>) and fill in your values. Load it in the UI with "Load .env file",
# or let the server read .env. Env files are never committed to source control (.env and .env.* are gitignored).
#
# Multi-line private keys: write them on ONE line with \n in place of each line break, e.g.
#   OCP_MGMT_HOST_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----\nb3Bl...\n-----END OPENSSH PRIVATE KEY-----
# The "Install New Cluster" wizard can generate fresh key pairs and write them into a copy of this file for you.

# ═══════════════════════════════════════════════════════════════════════════
# 1. IONOS Cloud account
# ═══════════════════════════════════════════════════════════════════════════

# IONOS Cloud API token (DCD → Management → Token Manager)
IONOS_API_TOKEN=

# IONOS FTP credentials — used only to upload the agent-installer ISO and custom images (RHCOS).
# These are your IONOS DCD account email + password, NOT the API token.
# The FTP host is derived from the VDC location (de/fra → ftp-fra.ionos.com, gb/bhx → ftp-bhx.ionos.com, ...).
IONOS_FTP_USER=
IONOS_FTP_PASS=

# ═══════════════════════════════════════════════════════════════════════════
# 2. Connection to an OpenShift cluster (written for you at the end of an install)
# ═══════════════════════════════════════════════════════════════════════════

# OpenShift API endpoint (port 6443)
OCP_CLUSTER_API_URL=https://api.your-cluster.example.com:6443

# Bearer token for the API. The Install wizard creates a long-lived one (service account
# openshift-machine-api/ionos-scaling-app, cluster-admin) and writes it here. Otherwise obtain one with
# `oc whoami -t` (user tokens expire — update this when you get a 401) or leave blank and use the UI's
# "Get Token" button (needs the management host and the admin login below).
OCP_BEARER_TOKEN=

# Cluster admin login — used by the "Get Token" button to run `oc login` on the management host over SSH.
# The Install wizard writes kubeadmin and its password here. Only sent to your own management host; not stored by the tool.
OCP_ADMIN_USERNAME=
OCP_ADMIN_PASSWORD=

# kubeconfig on the management host used by the tool's `oc` commands (default /root/.kube/config).
# If you use the copy that skips TLS verification (created by the TLS phase): /tmp/kc-skip-verify
# OCP_KUBECONFIG_PATH=/root/.kube/config

# Management / bastion host: public IP or hostname, private IP, and the SSH key for root on it.
OCP_MGMT_HOST=
OCP_MGMT_INTERNAL_IP=
OCP_MGMT_HOST_SSH_KEY=

# SSH key of the nodes' core user (the private half of the key embedded in the MachineConfigs / agent-config).
# Used to watch worker installs and to switch boot devices. Same one-line format. Without it, installs run unmonitored.
OCP_WORKER_SSH_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# 3. Worker node networking (adding workers, static IP bootstrap)
# ═══════════════════════════════════════════════════════════════════════════

# Default hostname prefix for new workers (pre-fills the Server Name field). The Install wizard writes <cluster>-worker.
OCP_WORKER_NAME_PREFIX=

# DNS servers written into the bootstrap ISO's NetworkManager keyfile (semicolon-separated, trailing semicolon).
# They must resolve api-int.<cluster domain>. IONOS default shown.
OCP_BOOTSTRAP_DNS=212.227.123.16;212.227.123.17;

# Default gateway of the private worker LAN (the NAT gateway, the .1 address). IONOS DHCP gives an address but no
# default route, so it is embedded. The Install wizard writes it.
OCP_BOOTSTRAP_GATEWAY=

# Prefix length of the private worker LAN (23 for 10.7.222.0/23, 24 for 10.7.224.0/24).
OCP_BOOTSTRAP_PREFIX_LENGTH=24

# ═══════════════════════════════════════════════════════════════════════════
# 4. Install New Cluster wizard (pre-fills the wizard form)
# ═══════════════════════════════════════════════════════════════════════════

# Red Hat pull secret (https://console.redhat.com/openshift/install/pull-secret): the full JSON, on one line.
RH_PULL_SECRET=

# Cluster identity
NCW_CLUSTER_NAME=
NCW_BASE_DOMAIN=
# OpenShift version, e.g. 4.20.x (latest 4.20) or an exact 4.20.46
NCW_OCP_VERSION=

# Where it is built. NCW_VDC_LOCATION: de/fra, de/fra/2, de/txl, es/vit, fr/par, gb/lhr, gb/bhx, us/las, us/ewr, us/mci
NCW_VDC_NAME=
NCW_VDC_LOCATION=de/fra

# Control plane: ENTERPRISE (Dedicated Core), VCPU (shared cores, Balanced SSD) or CUBE.
# NCW_CP_CPU_FAMILY is only used for ENTERPRISE; only families orderable at the location are offered
# (e.g. gb/bhx: AMD_EPYC = AMD EPYC Milan, INTEL_ICELAKE). Leave blank for vCPU/Cube.
NCW_CP_SERVER_TYPE=ENTERPRISE
NCW_CP_CPU_FAMILY=
NCW_CP_CORES=8
NCW_CP_RAM_GB=16
NCW_CP_DISK_GB=600

# Management host (shared-core vCPU server running the installer, web server and oc/opct). 2 vCPU / 4 GB was too small:
# 4 vCPU / 8 GB is the minimum recommended; use more RAM if you generate OPCT reports on it.
NCW_MGMT_CORES=4
NCW_MGMT_RAM_GB=8
NCW_MGMT_DISK_GB=50

# Planned workers (added after the install): ENTERPRISE, VCPU or CUBE (CUBE needs a template name or id).
NCW_W_SERVER_TYPE=CUBE
NCW_W_REPLICAS=2
NCW_W_CUBE_TEMPLATE=

# Public halves of the SSH keys (the wizard can generate the pairs and fill these in).
# NCW_MGMT_SSH_PUBKEY goes onto the management VM, NCW_OCP_SSH_PUBKEY onto the OpenShift nodes (core user).
NCW_MGMT_SSH_PUBKEY=
NCW_OCP_SSH_PUBKEY=

# ═══════════════════════════════════════════════════════════════════════════
# 5. DNS and TLS certificates (wizard TLS phase, cert-manager + Let's Encrypt)
# ═══════════════════════════════════════════════════════════════════════════

# DNS_PROVIDER: cloud    = IONOS Cloud DNS (the zone below must exist and be delegated to IONOS)
#               consumer = IONOS domain DNS (needs the API key prefix and secret below)
DNS_PROVIDER=cloud
# Cloud DNS: the zone (e.g. alb-test.vintagestereo.de), which is also the base domain.
# Consumer DNS: the registered domain name.
DNS_DOMAIN=

# Consumer DNS only: IONOS DNS API key (shown as <prefix>.<secret>)
DNS_API_KEY_PREFIX=
DNS_API_KEY_SECRET=

# Let's Encrypt account email (expiry notices). Defaults to admin@<DNS_DOMAIN> if blank.
ACME_EMAIL=

# DNS-01 webhook image. Leave blank for the default (ghcr.io/paul-mccutcheon-ionos/cert-manager-webhook-ionos:1.2.2-custom).
CERT_WEBHOOK_IMAGE=

# ═══════════════════════════════════════════════════════════════════════════
# 6. Container registry for the IONOS Machine API provider (autoscaler setup)
# ═══════════════════════════════════════════════════════════════════════════
# Pre-fills the "Deploy provider" section of the autoscaler wizard.

# REGISTRY_TYPE: dockerhub | ghcr | ionos | custom
REGISTRY_TYPE=ghcr

# Docker Hub: username/repo:tag    GHCR: ghcr.io/username/repo:tag    IONOS / custom: full URL with registry host
REGISTRY_IMAGE=ghcr.io/paul-mccutcheon-ionos/ionos-machine-api-provider:ionos-machine-api-provider

# Leave blank for public images
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════
# 7. The tool itself
# ═══════════════════════════════════════════════════════════════════════════

# Port the tool listens on (default 3000)
# PORT=3000

# Optional password protection for the server-side .env auto-fill.
# AUTH_CONTRACT_ID is shown in the password prompt; AUTH_PASSWORD_HASH is a bcrypt hash of the password:
#   node -e "require('bcryptjs').hash('yourpassword',10).then(h=>console.log(h))"
# Leave both blank to disable.
AUTH_CONTRACT_ID=
AUTH_PASSWORD_HASH=
